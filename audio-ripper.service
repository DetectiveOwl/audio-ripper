[Unit]
Description=audio-ripper - estrattore audio personale (solo 127.0.0.1)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/audio-ripper
ExecStart=/home/ubuntu/audio-ripper/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
